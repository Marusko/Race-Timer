<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>onlyRmini.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFAC010 (.NET 8) / WFO0003 (.NET 10) suggest moving DPI settings from app.manifest to the WinForms
         ApplicationHighDpiMode property, but this is a WPF app (WinForms is referenced only for
         System.Windows.Forms.Screen) and WPF reads DPI awareness from the manifest, so the settings must stay -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
    <!-- The one place the app version is written: shown in the Information tab, and what ClickWrap
         falls back to when the app was not installed by its installer. Keep the publish profile's
         ApplicationVersion in step with it -->
    <Version>3.4.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="UI\onlyRmini.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="GuerrillaNtp" Version="3.1.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- ClickWrap update client, built from https://github.com/Marusko/ClickWrap. Referenced as a DLL
         because it is not published to a NuGet feed -->
    <Reference Include="ClickWrap.UpdateClient">
      <HintPath>lib\ClickWrap.UpdateClient.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="UI\onlyRmini.png" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Resources\EventTypeResource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>EventTypeResource.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources\EventTypeResource.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>EventTypeResource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>