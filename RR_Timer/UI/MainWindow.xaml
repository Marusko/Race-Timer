<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:clockUserControl="clr-namespace:Race_timer.ClockUserControl"
        xmlns:ui="clr-namespace:Race_timer.UI"
        x:Name="Main"
        x:Class="Race_timer.UI.MainWindow"
        mc:Ignorable="d"
        Title="Race Timer" Height="620" Width="960"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        Icon="/UI/onlyRmini.png" ResizeMode="CanMinimize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:MenuTabControl x:Name="TabControl" Grid.Row="0" TabStripPlacement="Left" Padding="18,6,6,6">
            <!-- Sits under the tabs, at the bottom of the left menu - see the TabControl template
                 in the theme, which renders the Tag below the tab strip -->
            <ui:MenuTabControl.Tag>
                <Button x:Name="CreateApiButton" Content="Create API" Click="OpenApiCreator"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="10,7"
                        ToolTip="Log in to RaceResult and create the API links for an event" />
            </ui:MenuTabControl.Tag>

            <!-- ============================ Starts ============================ -->
            <TabItem x:Name="StartsTab" Header="Starts" ToolTip="Individual starts setup">
                <TabControl x:Name="StartsTabControl">
                    <TabItem x:Name="StartsSetupTab" Header="Setup" ToolTip="Enable and setup sources of starts times">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer Grid.Column="1" Width="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,24">
                                    <TextBlock Text="Individual starts" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="Show a per-participant start countdown from a CSV file or the RaceResult API."
                                               Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,0" />

                                    <CheckBox x:Name="StartsEnableCheckbox" Content="Enable individual starts" Margin="0,18,0,0"
                                              ToolTip="Enable individual starts" Click="EnableStarts" />
                                    <CheckBox x:Name="ApiStartsCheckbox" Content="Use list from API" Margin="0,12,0,0"
                                              ToolTip="Use starts list from API" IsEnabled="False" Click="EnableApiStarts" />

                                    <StackPanel IsEnabled="{Binding IsChecked, ElementName=ApiStartsCheckbox}">
                                        <TextBlock Text="Start time filter field" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="StartsFilterText" Text="Start.ToD.Decimal" FontFamily="Consolas"
                                                 ToolTip="Race Result field with start time of day in seconds, used to filter loaded starts" />
                                    </StackPanel>

                                    <Border Background="{StaticResource BorderSoftBrush}" Height="1" Margin="0,20,0,4" />
                                    <TextBlock Text="Or upload a CSV file" Style="{StaticResource FieldLabelStyle}" Margin="2,4,0,6" />
                                    <Grid x:Name="StartsSetupButtons" IsEnabled="False">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" x:Name="LoadStartsFileButton" Content="Select file" Click="LoadCsvFile"
                                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,5,0" ToolTip="Select CSV file from PC" />
                                            <Button Grid.Column="1" x:Name="DeleteStartsFileButton" Content="Delete file" Click="DeleteCsvFile"
                                                    Style="{StaticResource SecondaryButtonStyle}" Margin="5,0,0,0" IsEnabled="False" ToolTip="Clear starts file" />
                                        </Grid>
                                        <Label Grid.Row="1" x:Name="StartsFileName" Content="" HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" Padding="0" Margin="0,8,0,0" />
                                        <Button Grid.Row="2" Content="Open Timer" Click="OpenStartsTimer" Margin="0,18,0,0" ToolTip="Start the timer" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="StartsControlTab" Header="Control" ToolTip="Control starts times">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Content="Close Timer" HorizontalAlignment="Center" Click="CloseStartsTimer"
                                    Margin="0,0,0,14" ToolTip="Stop and close the starts timer" />
                            <DataGrid Grid.Row="1" Name="IndividualStartDataGrid" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Bib" MinWidth="60" Binding="{Binding Path=Bib}" />
                                    <DataGridTextColumn Header="Name" Width="*" MinWidth="140" Binding="{Binding Path=Name}" />
                                    <DataGridTextColumn Header="Start time" MinWidth="120" Binding="{Binding Path=Time}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>

            <!-- ============================ Finish timer ============================ -->
            <TabItem x:Name="TimerTab" Header="Finish timer" ToolTip="Timer setup">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="1" Width="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,24">
                            <TextBlock Text="Finish timer" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Set up a manual timer with the event name, type and logo."
                                       Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,0" />

                            <TextBlock Text="Event name" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="EventNameText" TextWrapping="Wrap" HorizontalScrollBarVisibility="Auto"
                                     InputScope="RegularExpression" ToolTip="Event Name" />

                            <TextBlock Text="Event type" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="EventTypeComboBox" ToolTip="Event type" />

                            <TextBlock Text="Logo image" Style="{StaticResource FieldLabelStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Select Image" Click="OpenImage" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,5,0" ToolTip="Select logo image from PC" />
                                <Button Grid.Column="1" x:Name="DeleteImageButton" Content="Delete Image" Click="DeleteImage"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="5,0,0,0" IsEnabled="False" ToolTip="Clear logo image" />
                            </Grid>
                            <Label x:Name="ImageName" Content="" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" Padding="0" Margin="0,8,0,0" />

                            <Button Content="Open Timer" Click="OpenTimer" Margin="0,22,0,0" ToolTip="Start the timer" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============================ Finish API Timer ============================ -->
            <TabItem x:Name="LinkTimerTab" Header="Finish API Timer" ToolTip="API timer setup">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="1" Width="640" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,24">
                            <TextBlock Text="API timer" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Load the event, count, contest and starts APIs from a single RaceResult link."
                                       Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,0" />

                            <Label x:Name="ApiLinkTextLabel" Content="API Link" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12.5" FontWeight="Medium" Padding="0" Margin="2,14,0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="LinkText" TextWrapping="Wrap" InputScope="Url" ToolTip="Link for all API" />
                                <Button Grid.Column="1" Content="Load" Click="LoadApis" Margin="8,0,0,0"
                                        ToolTip="Loads the APIs from entered link" />
                            </Grid>

                            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="18,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Grid.Column="0" x:Name="MainStatusGrid" Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Content="Main API" />
                                        <Label Grid.Column="1" x:Name="EventStatusLabel" Content="MIS" Style="{StaticResource StatusValueStyle}" />
                                    </Grid>
                                    <Grid Grid.Row="0" Grid.Column="2" x:Name="CountStatusGrid" Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Content="Count API" />
                                        <Label Grid.Column="1" x:Name="CountStatusLabel" Content="MIS" Style="{StaticResource StatusValueStyle}" />
                                    </Grid>
                                    <Grid Grid.Row="1" Grid.Column="0" x:Name="ContestStatusGrid" Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Content="Contest API" />
                                        <Label Grid.Column="1" x:Name="ContestStatusLabel" Content="MIS" Style="{StaticResource StatusValueStyle}" />
                                    </Grid>
                                    <Grid Grid.Row="1" Grid.Column="2" x:Name="StartsStatusGrid" IsEnabled="False" Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Content="Starts API" />
                                        <Label Grid.Column="1" x:Name="StartsStatusLabel" Content="OFF" Style="{StaticResource StatusValueStyle}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <TextBlock Text="Logo image" Style="{StaticResource FieldLabelStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="LinkLoadImageButton" Content="Select Image" Click="OpenImage"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,5,0" ToolTip="Select logo image from PC" />
                                <Button Grid.Column="1" x:Name="LinkDeleteImageButton" Content="Delete Image" Click="DeleteImage"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="5,0,0,0" IsEnabled="False" ToolTip="Clear logo image" />
                            </Grid>
                            <Label x:Name="LinkImageName" Content="" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" Padding="0" Margin="0,8,0,0" />

                            <Button x:Name="LinkStartTimerButton" Content="Open Timer" Click="OpenLinkTimer" Margin="0,20,0,0"
                                    ToolTip="Start the timer" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============================ Contests ============================ -->
            <TabItem x:Name="ContestsTab" Header="Contests" ToolTip="Setup one or multiple contests">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Contests" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" CornerRadius="7" Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <Label x:Name="TimesNumberLabel" Content="0" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Padding="0" />
                        </Border>
                        <Button Grid.Column="3" Content="Add contest" Click="AddStartTime" ToolTip="Adds new contest" />
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                            <StackPanel x:Name="ContestsStackPanel" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================ Displaying ============================ -->
            <TabItem x:Name="ResultCodeTab" Header="Displaying" ToolTip="Setup results, info panel and QR code">
                <TabControl>
                    <TabItem x:Name="ResultTab" Header="Results" ToolTip="Enable and setup WebView">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer Grid.Column="1" Width="640" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,24">
                                    <TextBlock Text="Results &amp; info panel" Style="{StaticResource SectionTitleStyle}" />

                                    <CheckBox x:Name="WebViewEnableCheckBox" Content="Enable WebView" Margin="0,16,0,0" ToolTip="Enable WebView" />
                                    <TextBlock Text="Link to web page with results" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="ResultLinkText" TextWrapping="Wrap" InputScope="Url" ToolTip="Link to result page"
                                             IsEnabled="{Binding IsChecked, ElementName=WebViewEnableCheckBox}" />

                                    <CheckBox x:Name="InfoEnableCheckBox" Content="Enable info panel" Margin="0,22,0,0" ToolTip="Enable Info panel" />
                                    <TextBlock Text="Information to show - separate with ';'" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="InfoText" TextWrapping="Wrap" ToolTip="Information to show on info panel"
                                             Text="Tieto, ale aj ďalšie výsledky a súťaže nájdete na stránke casomierapt.com"
                                             IsEnabled="{Binding IsChecked, ElementName=InfoEnableCheckBox}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="CodeTab" Header="QR code" ToolTip="Generate or set QR image">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer Grid.Column="1" Width="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,24">
                                    <TextBlock Text="QR code" Style="{StaticResource SectionTitleStyle}" />

                                    <TextBlock Text="Generate from a link" Style="{StaticResource FieldLabelStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="CodeLinkText" TextWrapping="Wrap" InputScope="Url" ToolTip="Link to convert" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="Generate QR" Click="GenerateCode" Margin="8,0,0,0"
                                                ToolTip="Run the generator and set the generated QR code" />
                                    </Grid>

                                    <Border Background="{StaticResource BorderSoftBrush}" Height="1" Margin="0,20,0,0" />
                                    <TextBlock Text="Or select an image" Style="{StaticResource FieldLabelStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Select QR" Click="OpenCode" Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,5,0" ToolTip="Select QR code/image from PC" />
                                        <Button Grid.Column="1" x:Name="DeleteCodeButton" Content="Delete QR" Click="DeleteCode"
                                                Style="{StaticResource SecondaryButtonStyle}" Margin="5,0,0,0" IsEnabled="False" ToolTip="Clear the QR code/image" />
                                    </Grid>
                                    <Label x:Name="CodeName" Content="" HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" Padding="0" Margin="0,8,0,0" />

                                    <CheckBox x:Name="CodeCheckBoxForMinimized" Content="Show QR code when minimized" Margin="0,18,0,0"
                                              IsEnabled="{Binding IsEnabled, ElementName=DeleteCodeButton}"
                                              ToolTip="If enabled, QR code will be shown in periods when timer is small" />
                                    <clockUserControl:CodeOnMinimized x:Name="MinimizedCodeTimes" HorizontalAlignment="Left" Margin="0,12,0,0"
                                                                      IsEnabled="{Binding IsChecked, ElementName=CodeCheckBoxForMinimized}" ToolTip="Sets the intervals" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>

            <!-- ============================ Timer control ============================ -->
            <TabItem x:Name="ControlTab" Header="Timer control" ToolTip="Control size or close the timer">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="WebReloadButton" Content="Reload" Click="Reload" Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,0" ToolTip="Reload WebView page" />
                            <Button x:Name="MinimizeButton" Content="Minimize" Click="MinimizeTimerHandler"
                                    Margin="0,0,8,0" ToolTip="Make the timer small in the upper side of screen" />
                            <Button x:Name="MaximizeButton" Content="Maximize" Click="MaximizeTimerHandler"
                                    Margin="0,0,8,0" ToolTip="Make the timer big and on fullscreen" />
                            <Button Content="Close Timer" Click="CloseTimer" Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Stop and close the timer" />
                        </StackPanel>

                        <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Change a contest start time" Style="{StaticResource FieldLabelStyle}" Margin="2,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="ContestComboBox" ToolTip="Contest for which start time has to be changed" />
                                    <TextBox Grid.Column="1" x:Name="NewStartTime" Margin="8,0" Text="00:00:00" Width="90"
                                             TextAlignment="Center" ToolTip="New contest start time" />
                                    <Button Grid.Column="2" x:Name="NewStartButton" Click="SetNewStartTime" Content="Set"
                                            ToolTip="Set the new start time for selected contest" />
                                </Grid>

                                <TextBlock Text="Info panel message" Style="{StaticResource FieldLabelStyle}" Margin="2,14,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="NewInfoText" Text="" ToolTip="New information to show on info panel" />
                                    <Button Grid.Column="1" x:Name="NewInfoButton" Click="SetInfo" Content="Set" Margin="8,0,0,0"
                                            ToolTip="Set the new information" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Current start times" Style="{StaticResource FieldLabelStyle}" Margin="2,0,0,6" />
                        <DataGrid Grid.Row="1" Name="StartTimesDataGrid" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Width="*" MinWidth="140" Binding="{Binding Path=Key}" />
                                <DataGridTextColumn Header="Start time" MinWidth="120" Binding="{Binding Path=Value}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============================ Settings ============================ -->
            <TabItem Header="Settings" ToolTip="Display settings and app information">
                <TabControl x:Name="SettingsTabControl">
                    <TabItem x:Name="SettingsTab" Header="Display settings" ToolTip="Set display and layout">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer Grid.Column="1" Width="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,24">
                                    <TextBlock Text="Display settings" Style="{StaticResource SectionTitleStyle}" />

                                    <TextBlock Text="Display" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox x:Name="ScreenComboBox" ToolTip="Choose on which screen the timer will be displayed" />

                                    <TextBlock Text="Timer and image alignment" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox x:Name="AlignmentComboBox"
                                              ToolTip="Choose on which side of the fullscreen window will timer be, QR code will be displayed only in Left and Right mode" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="InfoTab" Header="Information" ToolTip="Information about app">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Race Timer" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <Label x:Name="InfoLabel" Content="Info" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" Padding="0" Margin="0,10,0,0" />
                            <TextBlock Text="Used external content" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,22,0,8" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Margin="10,0"><Hyperlink Click="OpenGithub"><Run Text="Github" /></Hyperlink></TextBlock>
                                <TextBlock Margin="10,0"><Hyperlink Click="OpenJsonPage"><Run Text="Newtonsoft.Json" /></Hyperlink></TextBlock>
                                <TextBlock Margin="10,0"><Hyperlink Click="OpenCodePage"><Run Text="QRCoder" /></Hyperlink></TextBlock>
                                <TextBlock Margin="10,0"><Hyperlink Click="OpenNptPage"><Run Text="GuerrillaNTP" /></Hyperlink></TextBlock>
                                <TextBlock Margin="10,0"><Hyperlink Click="OpenClickWrapPage"><Run Text="ClickWrap" /></Hyperlink></TextBlock>
                                <TextBlock Margin="10,0"><Hyperlink Click="OpenRaceResultClientPage"><Run Text="RaceResultClient" /></Hyperlink></TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </TabItem>
        </ui:MenuTabControl>

        <!-- Status bar -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="16,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="NTP sync:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <Label x:Name="NtpStatusLabel" Content="No sync" Style="{StaticResource StatusValueStyle}" FontSize="12" Padding="6,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
