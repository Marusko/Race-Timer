<Window x:Class="Race_timer.UI.WarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Race Timer" Topmost="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        ShowInTaskbar="False" IsTabStop="False" UseLayoutRounding="True"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen" Icon="/UI/onlyRmini.png">
    <!-- Two layers: an empty border carries the drop shadow, the content border
         on top renders text crisply with no effect applied. -->
    <Grid Margin="18">
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="3" Direction="270" Opacity="0.5" Color="#000000" />
            </Border.Effect>
        </Border>

        <Border Width="400" Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                SnapsToDevicePixels="True">
            <StackPanel Margin="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="IconBadge" Grid.Column="0" Width="38" Height="38"
                            CornerRadius="19" Margin="0,0,14,0" VerticalAlignment="Top">
                        <TextBlock x:Name="IconGlyph" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="WarningLabel" Margin="0,8,0,0" FontSize="14" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <Button x:Name="OkButton" Content="OK" HorizontalAlignment="Right" MinWidth="92"
                        Margin="0,22,0,0" Click="CloseWindow" IsDefault="True" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
